# ==========================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Backend Evaluación Países
# ==========================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NO incluyas el archivo .env en el control de versiones
# 4. Este archivo (.env.example) SÍ puede ser versionado de forma segura
# ==========================================

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL
# ==========================================

# Usuario de PostgreSQL
# Por defecto: postgres (o tu usuario configurado)
DB_USER=postgres

# Contraseña de PostgreSQL
# IMPORTANTE: Reemplaza con tu contraseña real
DB_PASSWORD=tu_contraseña_aqui

# Host donde se ejecuta PostgreSQL
# Opciones comunes: localhost, 127.0.0.1, o tu host de base de datos
DB_HOST=localhost

# Puerto de PostgreSQL
# Por defecto: 5432 (puerto estándar de PostgreSQL)
DB_PORT=5432

# Nombre de la base de datos a utilizar
# Esta base de datos debe existir antes de iniciar el servidor
DB_DATABASE=eva7

# ==========================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND
# ==========================================

# Puerto en el que se ejecutará el servidor backend
# Asegúrate de que este puerto no esté en uso por otra aplicación
# El frontend (Angular) está configurado para conectarse a este puerto
PORT=4000

# ==========================================
# NOTAS DE CONFIGURACIÓN
# ==========================================

# 1. Crear la base de datos si no existe:
#    psql -U postgres -c "CREATE DATABASE eva7;"
#
# 2. Verificar conexión a PostgreSQL:
#    psql -U postgres -h localhost -d eva7
#
# 3. Verificar que el puerto esté disponible:
#    # En macOS/Linux:
#    lsof -i :4000
#    # En Windows:
#    netstat -ano | findstr :4000
#
# 4. Configuración del frontend:
#    El frontend debe apuntar a: http://localhost:4000
#    Ubicación: /src/app/services/countries.services.ts
