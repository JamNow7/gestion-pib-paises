# ==========================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Frontend Gestión de Países - Angular
# ==========================================
# ⚠️ IMPORTANTE: ESTE ARCHIVO ES SOLO DOCUMENTACIÓN
# ==========================================
#
# Si vienes de otros frameworks como Node.js/Express, puedes esperar
# encontrar archivos .env funcionales. AQUÍ NO EXISTEN POR DISEÑO.
#
# Angular NO usa archivos .env tradicionales como lo hace Node.js.
#
# ❌ NO crees un archivo .env - Angular no lo leerá
# ❌ NO instales paquetes como @ngx-env-builder - No son necesarios
# ✅ USE el sistema nativo de Angular en /src/environments/
#
# ==========================================

# ==========================================
# ¿POR QUÉ ANGULAR NO USA ARCHIVOS .ENV?
# ==========================================

# La diferencia FUNDAMENTAL entre backend y frontend:

# 🔧 BACKEND (Node.js/Express):
#    ✅ SÍ usa archivos .env
#    ✅ Ejecuta en el servidor
#    ✅ Las variables se leen en RUNTIME (cuando arranca el servidor)
#    ✅ Las credenciales quedan protegidas en el servidor
#
# 🎯 FRONTEND (Angular):
#    ❌ NO usa archivos .env (y no debería)
#    ✅ Ejecuta en el navegador del cliente
#    ✅ Las variables se resuelven en BUILD-TIME (cuando compilas)
#    ✅ El código JavaScript final tiene los valores "compilados"
#    ✅ No hay forma de ocultar credenciales en el navegador

# ==========================================
# ¿POR QUÉ ESTE DISEÑO ES CORRECTO?
# ==========================================

# 1. SEGURIDAD REALISTA:
#    - Angular corre en el navegador del cliente
#    - Todo el código JavaScript es visible para cualquier usuario
#    - Usar .env daría FALSA seguridad de protección
#    - Credenciales reales DEBEN estar en el backend

# 2. OPTIMIZACIÓN:
#    - Variables se resuelven al compilar (build-time)
#    - Bundle final más pequeño y eficiente
#    - No hay procesamiento adicional en runtime

# 3. TYPE-SAFE:
#    - Variables tipadas en TypeScript
#    - IntelliSense completo en tu IDE
#    - Errores detectados en tiempo de compilación

# 4. SISTEMA NATIVO:
#    - No requiere librerías adicionales
#    - Funciona "out of the box"
#    - Es la forma ESTÁNDAR de Angular

# ==========================================
# SISTEMA NATIVO DE ANGULAR (IMPLEMENTADO)
# ==========================================

# Angular utiliza archivos TypeScript en /src/environments/:

# 📁 src/environments/environment.ts (DESARROLLO):
#    export const environment = {
#      production: false,
#      apiUrl: 'http://localhost:4000',
#      apiEndpoint: '/paises',
#      fullApiUrl: 'http://localhost:4000/paises'
#    };

# 📁 src/environments/environment.prod.ts (PRODUCCIÓN):
#    export const environment = {
#      production: true,
#      apiUrl: 'https://api.ejemplo.com',
#      apiEndpoint: '/paises',
#      fullApiUrl: 'https://api.ejemplo.com/paises'
#    };

# ==========================================
# CÓMO FUNCIONA ESTE SISTEMA
# ==========================================

# 1. DESARROLLO:
#    ng serve
#    → Usa automáticamente: src/environments/environment.ts
#    → URL del backend: http://localhost:4000/paises

# 2. PRODUCCIÓN:
#    ng build --configuration production
#    → Usa automáticamente: src/environments/environment.prod.ts
#    → URL del backend: https://api.ejemplo.com/paises
#    → Reemplaza environment.ts por environment.prod.ts

# 3. EL TRUCO ESTÁ EN angular.json:
#    "fileReplacements": [
#      {
#        "replace": "src/environments/environment.ts",
#        "with": "src/environments/environment.prod.ts"
#      }
#    ]

# ==========================================
# CÓMO CAMBIAR LA URL DEL BACKEND
# ==========================================

# Para desarrollo:
# 1. Edita src/environments/environment.ts
# 2. Modifica apiUrl y fullApiUrl
# 3. Reinicia: ng serve

# Para producción:
# 1. Edita src/environments/environment.prod.ts
# 2. Modifica apiUrl y fullApiUrl
# 3. Reconstruye: ng build --configuration production

# ==========================================
# ENTONCES, ¿DÓNDE PONGO CREDENCIALES SENSIBLES?
# ==========================================

# ✅ RESPUESTA CORRECTA: En el BACKEND (Node.js)
#
# El backend (eva7) tiene archivos .env reales:
# - .env            (credenciales reales - no versionar)
# - .env.example    (documentación - sí versionar)
#
# El frontend hace peticiones al backend, y el backend
# se comunica con servicios externos usando sus credenciales.

# Flujo seguro:
# Frontend (Angular) → Backend (Node.js) → Servicios externos
#                       ↑
#                  Credenciales .env aquí

# ==========================================
# VERIFICACIÓN DE CONEXIÓN AL BACKEND
# ==========================================

# Antes de iniciar el frontend, verifica que el backend esté corriendo:
curl http://localhost:4000/paises

# Iniciar backend:
cd /ruta/al/backend/eva7
npm run dev

# ==========================================
# PUERTOS CONFIGURADOS
# ==========================================

# Frontend (Angular): http://localhost:4200
# Backend (Node.js):  http://localhost:4000
#
# CORS backend configurado para aceptar: http://localhost:4200

# ==========================================
# NOTAS IMPORTANTES
# ==========================================

# 1. CAMBIOS REQUIEREN REINICIO:
#    Después de modificar archivos environment.ts,
#    necesitas reiniciar ng serve para que los cambios surtan efecto.

# 2. BUILD DE PRODUCCIÓN:
#    Para producción, usa: ng build --configuration production
#    Esto usará automáticamente environment.prod.ts

# 3. AGREGAR MÁS VARIABLES:
#    Si necesitas agregar más configuraciones, agrégalas a:
#    - src/environments/environment.ts (desarrollo)
#    - src/environments/environment.prod.ts (producción)

# ==========================================
# RESUMEN FINAL
# ==========================================

# ✅ ESTE ARCHIVO (.env.example) ES SOLO DOCUMENTACIÓN
# ✅ NO crees un archivo .env en Angular
# ✅ USA el sistema nativo en /src/environments/
# ✅ Credenciales sensibles van en el BACKEND
# ✅ Este sistema es CORRECTO y PROFESIONAL para Angular
